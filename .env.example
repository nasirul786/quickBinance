# Telegram bot token from @BotFather
BOT_TOKEN=

# 32-byte hex key used to encrypt users' Binance API keys at rest.
# Generate one with: npm run genkey
# NEVER change or lose this after users connect, or their stored keys become unreadable.
ENCRYPTION_KEY=

# Path to the SQLite database file
DB_PATH=./data/quickbinance.db

# Binance REST endpoint (change only if you know what you're doing)
BINANCE_BASE_URL=https://api.binance.com

# Minutes a pending tip waits for the sender to press Confirm
TIP_CONFIRM_TTL_MINUTES=5

# Proxy for Binance API requests only (Telegram connects directly). 1 = use, 0 = off.
# If users enable withdrawals, they must whitelist the PROXY's IP on their Binance API key.
USE_PROXY=0
# socks5 or http
PROXY_TYPE=socks5
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
